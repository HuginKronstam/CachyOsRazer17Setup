# Run logs (auto-generated, not for version control)
last-run.log
post-reboot.log

# Local state for Proton Drive incremental Obsidian backups
.proton-obsidian-backup-marker

# Sensitive configuration files
# Add any configs that contain passwords, API keys, or personal info

# Example sensitive files (uncomment if you add them):
# configs/git/.gitconfig          # May contain email/name
# configs/**/secrets.conf
# configs/**/*password*
# configs/**/*token*
# configs/**/*key*

# KDE wallet/credential files
configs/kde/*wallet*
configs/kde/*credential*

# SSH keys
configs/ssh/

# Browser profiles (may contain passwords/cookies)
configs/firefox/

# Vivaldi profile is backed up (bookmarks/preferences/etc.), but never
# these - defense in depth in case something slips past the rsync
# --exclude flags in cachyos-setup.sh
configs/vivaldi/**/*[Cc]ache*
configs/vivaldi/**/*Cookies*
configs/vivaldi/**/*Login Data*
configs/vivaldi/**/Singleton*

# Obsidian: allow-list, not deny-list. ~/.config/obsidian is an Electron
# app data dir - almost everything in it is Chromium runtime internals
# (Cache, Cookies, IndexedDB, Local/Session Storage, Crashpad, etc.), not
# actual settings. An earlier backup did a blind `cp -r` of the whole
# directory and it ended up committing an Anthropic API key that a plugin
# had stored in IndexedDB, plus ~200 cache/cookie/storage files. Only the
# small top-level settings/window-state files are worth keeping, so
# ignore everything else by default - this also covers whatever new
# internal-state folder some future Electron version adds, which a
# deny-list of today's known-bad folders never would.
configs/obsidian/*
!configs/obsidian/*.json
!configs/obsidian/obsidian.log

# Backup files
*.backup
*.bak
*~

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
