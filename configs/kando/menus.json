              {
                "name": "Find app icon",
                "icon": "image_search",
                "iconTheme": "material-symbols-rounded",
                "type": "button",
                "selectWorkflow": {
                  "actions": [
                    {
                      "type": "execute-command",
                      "command": "env PATH=\"/usr/bin:/usr/sbin:$PATH\" bash -c '\n\nAPP=$(kdialog --inputbox \"Enter app name to find icon path:\");\n\nif [ -n \"$APP\" ]; then\n    PATH_TO_ICON=\"\"\n    DIRS=\"/usr/share/icons/ /var/lib/flatpak/exports/share/icons/ $HOME/.local/share/icons/ /usr/share/pixmaps/\"\n    SYMBOLS=\"symbolic|char-white/\"\n\n    # fn search all dir\n    search_icons() {\n        local appname=$1\n        local filter_symbolic=$2\n        local case_sensitive=$3\n\n        for dir in $DIRS; do\n            if [ -d \"$dir\" ]; then\n                # Find files matching the criteria in the current directory\n                local result\n\n                if [ \"$filter_symbolic\" = \"true\" ]; then\n                    if [ \"$case_sensitive\" = \"true\" ]; then\n                        result=$(find -L \"$dir\" -type f \\( -name \"$appname.png\" -o -name \"$appname.svg\" \\) 2>/dev/null | grep -vE -i \"$SYMBOLS\" | head -n 1)\n                    else\n                        result=$(find -L \"$dir\" -type f \\( -iname \"$appname.png\" -o -iname \"$appname.svg\" \\) 2>/dev/null | grep -vE -i \"$SYMBOLS\" | head -n 1)\n                    fi\n                else\n                    if [ \"$case_sensitive\" = \"true\" ]; then\n                        result=$(find -L \"$dir\" -type f \\( -name \"$appname.png\" -o -name \"$appname.svg\" \\) 2>/dev/null | head -n 1)\n                    else\n                        result=$(find -L \"$dir\" -type f \\( -iname \"$appname.png\" -o -iname \"$appname.svg\" \\) 2>/dev/null | head -n 1)\n                    fi\n                fi\n\n                if [ -n \"$result\" ]; then\n                    echo \"$result\"\n                    return 0\n                fi\n            fi\n        done\n        return 1\n    }\n\n    # exact case-sensitive match, no symbolic icons\n    PATH_TO_ICON=$(search_icons \"$APP\" \"true\" \"true\")\n\n    # exact case-insensitive match, no symbolic icons\n    if [ -z \"$PATH_TO_ICON\" ]; then\n        PATH_TO_ICON=$(search_icons \"$APP\" \"true\" \"false\")\n    fi\n\n    # loose case-insensitive match, no symbolic icons\n    if [ -z \"$PATH_TO_ICON\" ]; then\n        PATH_TO_ICON=$(search_icons \"*$APP\" \"true\" \"false\")\n    fi\n\n    # partial case-insensitive match, no symbolic icons\n    if [ -z \"$PATH_TO_ICON\" ]; then\n        PATH_TO_ICON=$(search_icons \"*$APP*\" \"true\" \"false\")\n    fi\n\n    # wildcard fallback\n    if [ -z \"$PATH_TO_ICON\" ]; then\n        for dir in $DIRS; do\n            if [ -d \"$dir\" ]; then\n                res=$(find \"$dir\" -iname \"*$APP*\" 2>/dev/null | head -n 1)\n                if [ -n \"$res\" ]; then PATH_TO_ICON=$res; break; fi\n            fi\n        done\n    fi\n\n    # output & notify\n    if [ -n \"$PATH_TO_ICON\" ]; then\n        if echo -n \"file://$PATH_TO_ICON\" | wl-copy; then\n            kdialog --icon dialog-information --title \"Icon Found\" --passivepopup \"Copied to clipboard:\\nfile://$PATH_TO_ICON\" 4\n        else\n            kdialog --icon dialog-error --title \"Icon Finder\" --passivepopup \"Found the icon but wl-copy failed (is wl-clipboard installed?):\\nfile://$PATH_TO_ICON\" 4\n        fi\n    else\n        kdialog --icon dialog-error --title \"Icon Finder\" --passivepopup \"No icon found for $APP\" 4\n    fi\nfi' || true ",
                      "detached": false,
                      "isolated": true
                    },
